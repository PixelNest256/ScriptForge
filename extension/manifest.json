{
  "manifest_version": 3,
  "name": "ScriptForge",
  "version": "0.1.3",
  "description": "AI-driven userscript manager with static analysis security gate",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/runner.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage", "tabs", "sidePanel", "downloads", "userScripts"],
  "minimum_chrome_version": "120",
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ScriptForge"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
